{
  "name": "shixu",
  "version": "1.0.0",
  "packageManager": "npm@11.9.0",
  "description": "Expo SDK 57 document scanner with automatic perspective correction, smart enhancement, watermarking, image export, and PDF export.",
  "keywords": [
    "expo",
    "react-native",
    "document-scanner",
    "pdf",
    "ios"
  ],
  "main": "index.ts",
  "dependencies": {
    "base64-js": "^1.5.1",
    "buffer": "^6.0.3",
    "expo": "~57.0.10",
    "expo-asset": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-media-library": "~57.0.3",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "jpeg-js": "^0.4.4",
    "lucide-react-native": "^1.27.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/base64-js": "^1.3.2",
    "@types/jpeg-js": "^0.3.0",
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.20.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/patch-expo-modules-jsi.mjs && node scripts/patch-expo-camera-live-document.mjs",
    "start": "expo start --dev-client --scheme shixu",
    "android": "expo run:android",
    "ios": "node scripts/ios-development-build.mjs",
    "web": "expo start --web",
    "changeset:add": "changeset",
    "version-packages": "changeset version",
    "release:build": "npm run typecheck && npm run doctor && npm run store:privacy:lint && npx expo export --platform ios",
    "ios:build": "npx --yes eas-cli@21.4.0 build --platform ios --profile production",
    "ios:submit": "npx --yes eas-cli@21.4.0 submit --platform ios --profile production",
    "ios:release": "npx --yes eas-cli@21.4.0 build --platform ios --profile production --auto-submit",
    "store:metadata:lint": "npx --yes eas-cli@21.4.0 metadata:lint",
    "store:metadata": "npx --yes eas-cli@21.4.0 metadata:push",
    "store:privacy:lint": "node scripts/check-ios-privacy-config.mjs",
    "test:detection": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-document-detection.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "doctor": "expo-doctor"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-camera"
        ]
      }
    }
  },
  "private": true
}
